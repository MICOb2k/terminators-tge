  <!-- Crosshair ticks -->
  <rect x="246" y="34" width="20" height="60" fill="#FF4D1C"/>
  <rect x="246" y="418" width="20" height="60" fill="#FF4D1C"/>
  <rect x="34" y="246" width="60" height="20" fill="#FF4D1C"/>
  <rect x="418" y="246" width="60" height="20" fill="#FF4D1C"/>

  <!-- Center emblem: the brand's angled flag/blaze mark, scaled up -->
  <polygon points="176,176 336,176 336,286 262,356 176,356"
           fill="#FF4D1C"/>
  <polygon points="176,176 336,176 336,286 262,356 176,356"
           fill="none" stroke="#0B0D0A" stroke-width="6"/>

  <!-- Inner reticle dot -->
